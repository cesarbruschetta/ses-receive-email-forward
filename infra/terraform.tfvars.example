# Regiao AWS
aws_region = "us-east-1"

# Nome base dos recursos
project_name = "ses-email-forwarder"

# Enderecos que o SES aceita receber (um ou varios)
ses_recipient_addresses = ["[EMAIL]", "[EMAIL]"]

# Enderecos que recebem o e-mail encaminhado (um ou varios)
forward_addresses = ["[EMAIL]"]

# Remetente do reenvio. O %s (opcional) e substituido pelo dominio que recebeu
from_address = "AWS Forward <no-reply@%s>"

# Nivel de log do Lambda
logger_level = "INFO"

# Tag da imagem do Lambda no ECR
lambda_image_tag = "latest"
